// Número de WhatsApp: solo dígitos, formato internacional (54 9 + área + número)
const WA_NUMBER = '5493472505151';

const waHref = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent('Hola! Quiero consultar por placas de siembra.')}`;
const waDisplay = WA_NUMBER.replace(/^549?(\d{3,4})(\d{2,3})(\d{4})$/, '+54 9 $1 $2-$3');

const marcas = ['Achillii','Agrometal', 'Apache','Ascanelli','Brioschi','Cele', 'Crucianelli','Dancar','DASA', 'Dolby', 'Dumaire', 'Erca','Fabimag', 'Fankhauser', 'FerCam', 'Fran Kausen', 'Geronzi', 'Gherardi', 'Giorgi', 'Juber', 'Jumil', 'Magna', 'Malasia', 'Metar', 'Migra', 'Monumental', 'Pierobon', 'Pla', 'Schiarre', 'Sembrar', 'Super Walter', 'Surka', 'Tanzi', 'Tedeschi', 'Tefoni', 'Templar', 'VHB','Otra'];
const semillas = ['Soja', 'Maíz', 'Girasol', 'Sorgo', 'Otra'];
const formas = [{ l: 'Redonda', w: '18px' }, { l: 'Alargada', w: '40px' }, { l: 'No sé', w: '0px' }];
const hileras = ['2', '3'];
// Hileras fijas y cantidades de alvéolos disponibles según la semilla. "Otra" (o sin elegir) queda libre.
const placasPorSemilla: Record<string, { hileras: string; alveolos: string[] }> = {
  'Maíz': { hileras: '2', alveolos: ['50', '56', '60', '66'] },
  'Girasol': { hileras: '2', alveolos: ['50', '56', '60'] },
  'Sorgo': { hileras: '2', alveolos: ['124', '142'] },
  'Soja': { hileras: '3', alveolos: ['141', '144', '171'] },
};
const alveolosLibres = ['50', '56', '60', '66'];

// Alvéolos por sembradora: marca | maíz alargado | maíz redondo | soja | sorgo | girasol. Las variantes de una misma marca
// (cruci/pla/erca...) son filas repetidas: se unifican sumando las opciones. Celda vacía = sin dato (cae a la lista por semilla).
const tipos = ['Maíz alargado', 'Maíz redondo', 'Soja', 'Sorgo', 'Girasol'];
const alveolosPorMarca: Record<string, Record<string, string[]>> = {};
`Achillii|66|66|171|124|50
Achillii|50|50|171|124|50
Agrometal|60|60|144|142|60
Apache||60|||30
Ascanelli|60|60|144|142|60
Ascanelli|66|66|171|124|50
Brioschi|50|50|171|124|50
Cele|50|50|171|124|50
Crucianelli|66|66|171|124|50
Dancar|50|50|171|124|50
DASA|50|50|171|124|50
Dolby|60|60|144|142|60
Dumaire|50|50|171|124|50
Erca|56|56|141|142|56
Fabimag|60|60|144|142|60
FerCam||34|||
FerCam|60|60|144|142|60
Fran Kausen|56|56|141|142|56
Geronzi|50||||
Gherardi||40|144||
Giorgi|42||||
Juber|60|60|144|142|60
Magna|66|66|171|124|50
Malasia|66|66|171|124|50
Metar|66|66|171|124|50
Metar|56|56|141|142|56
Metar|50|50|171|124|50
Migra|56|34|141|142|56
Monumental|50|66|171|124|50
Pierobon|50|50|171|124|50
Pierobon|34||||
Pla|50|50|171|124|50
Pla||50|||
Schiarre|56|56|141|142|56
Sembrar|56|56|141|142|56
Super Walter|66|66|171|124|50
Super Walter|50|50|171|124|50
Tedeschi|66|66|171|124|50
Tedeschi|50|50|171|124|50
Tefoni|66|66|171|124|50
Templar|50|50|171|124|50
VHB|56|56|141|142|56`.split('\n').forEach(l => {
  const [marca, ...vals] = l.split('|').map(s => s.trim());
  // Falla el build ante una marca mal escrita, una columna de más/menos o un valor no numérico.
  if (!marcas.includes(marca) || vals.length !== tipos.length || vals.some(v => v && !/^\d+$/.test(v))) throw new Error(`Fila inválida en alveolosPorMarca: "${l}"`);
  const m = (alveolosPorMarca[marca] ??= {});
  vals.forEach((v, i) => { if (v) (m[tipos[i]] ??= []).push(v); });
});
Object.values(alveolosPorMarca).forEach(m => Object.keys(m).forEach(k => (m[k] = [...new Set(m[k])].sort((a, b) => +a - +b))));

// Medidas disponibles. Cada fila es [largo, ancho, espesor] (alargadas) o [diámetro, espesor] (redondas).
// Con semilla (y tipo, en maíz) definidos se elige de esta lista; si no, se escribe a mano.
const comb = (...cols: string[][]) => cols.reduce<string[][]>((acc, c) => acc.flatMap(a => c.map(x => [...a, x])), [[]]);
const medidasPorTipo: Record<string, string[][]> = {
  'Maíz alargado': [...comb(['11', '12', '13', '13,5', '14', '15'], ['7', '8', '9'], ['4,5', '5,5', '6']), ['12,5', '8', '4,5']],
  'Maíz redondo': [['8', '5,5'], ['8', '6'], ...comb(['8,5', '9', '9,5', '10', '10,5', '11', '11,5', '12', '12,5', '13', '13,5', '14'], ['4,5', '5,5', '6'])],
  'Girasol': [
    ...comb(['10'], ['4', '5', '6'], ['3,3', '3,5']),
    ...comb(['11', '12'], ['4', '5', '6', '7', '8'], ['3,3', '3,5']),
    ...comb(['13'], ['5', '6', '7', '8'], ['3,3', '3,5']),
    ['14', '6', '3,3'],
  ],
  'Sorgo': [['3,75', '2,5'], ['4,25', '2,5'], ['4,5', '2,5'], ['4,75', '2,5'], ['4,5', '3'], ['5', '3'], ['5,25', '3']],
  'Soja': [['6,5', '5'], ['7', '5'], ['7,5', '5'], ['8,5', '5'], ['7', '5,5'], ['7,5', '5,5'], ['8', '5,5'], ['8,5', '5,5']],
};
