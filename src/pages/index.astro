<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Placas de Siembra · Placas dosificadoras para sembradoras</title>
<meta name="description" content="Fabricamos placas de siembra a medida para tu sembradora. Redondas y alargadas, hileras y alvéolos a pedido. Consultá por WhatsApp.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bitter:wght@500;700;800&family=Figtree:wght@400;500;600;700&display=swap" rel="stylesheet">
<style is:global>
html{scroll-behavior:smooth}
body{margin:0;background:#f6f2e8;color:#1c261e;font-family:Figtree,system-ui,sans-serif;-webkit-font-smoothing:antialiased}
a{color:#1d5628;text-decoration:underline;text-underline-offset:3px}
a:hover{color:#541d1d}
*{box-sizing:border-box}
input,select,button{font-family:inherit}
.slot img{width:100%;height:100%;object-fit:cover;display:block}
.field{min-height:52px;border:1.5px solid #d6cdb8;border-radius:12px;padding:0 14px;font-size:16px;background:#faf8f2;color:#1c261e}
.field:disabled{opacity:0.5}
.chip{background:#faf8f2;color:#1c261e;border:1.5px solid #d6cdb8;cursor:pointer}
.chip:disabled{opacity:0.35;cursor:not-allowed}
.chip[aria-pressed="true"]{background:#1d5628;color:#f6f2e8;border-color:#1d5628}
.card{background:#fff;border:1px solid #e3dccb;border-radius:18px;padding:22px 20px}
fieldset.card{margin:0;min-width:0}
fieldset.card:disabled{opacity:0.45}
.step{display:flex;align-items:center;gap:12px;margin-bottom:14px;font-weight:700;font-size:18px}
.step b{width:28px;height:28px;border-radius:50%;background:#1d5628;color:#f6e81d;display:grid;place-items:center;font-weight:800;font-size:14px}
#gl{display:block;width:100%;height:100%;cursor:grab}
#gl:active{cursor:grabbing}
.vbtn{font:600 13px/1 Figtree,system-ui,sans-serif;padding:9px 13px;border-radius:999px;border:1.5px solid rgba(246,242,232,0.35);background:none;color:#f6f2e8;cursor:pointer}
.vbtn[aria-pressed="true"]{background:#f6e81d;border-color:#f6e81d;color:#1d5628}
@media (min-width:840px){#resumen{max-height:calc(100vh - 100px);overflow-y:auto;scrollbar-width:none}#resumen::-webkit-scrollbar{display:none}}
@media (max-width:720px){.nav-link{display:none}}
@media (max-width:420px){.brand-text{font-size:16px!important}.nav-wa{padding:8px 12px!important;font-size:14px}}
</style>
</head>
<body>

<header style="position:sticky;top:0;z-index:20;background:rgba(246,242,232,0.94);backdrop-filter:blur(8px);border-bottom:1px solid #e3dccb">
  <div style="max-width:1180px;margin:0 auto;padding:12px 20px;display:flex;align-items:center;justify-content:space-between;gap:16px">
    <a href="#inicio" style="display:flex;align-items:center;gap:10px;text-decoration:none;color:#1d5628">
      <span style="width:34px;height:34px;border-radius:50%;background:#1d5628;display:grid;place-items:center">
        <span style="width:12px;height:12px;border-radius:50%;background:#f6e81d"></span>
      </span>
      <span class="brand-text" style="font-family:Bitter,serif;font-weight:800;font-size:19px;letter-spacing:-0.01em;line-height:1;white-space:nowrap">Placas de Siembra</span>
    </a>
    <nav style="display:flex;gap:22px;align-items:center;font-weight:600;font-size:15px">
      <a class="nav-link" href="#producto" style="color:#1c261e;text-decoration:none">Producto</a>
      <a class="nav-link" href="#cotizador" style="color:#1c261e;text-decoration:none">Cómo pedir</a>
      <a class="nav-link" href="#contacto" style="color:#1c261e;text-decoration:none">Contacto</a>
      <a class="nav-wa" href={waHref} target="_blank" rel="noopener" style="background:#f6e81d;color:#1d5628;text-decoration:none;padding:10px 16px;border-radius:999px;font-weight:700;display:flex;align-items:center;gap:8px;white-space:nowrap">
        <span style="width:8px;height:8px;border-radius:50%;background:#009919"></span>WhatsApp
      </a>
    </nav>
  </div>
</header>

<main>
<section id="inicio" style="background:#1d5628;color:#f6f2e8">
  <div style="max-width:1180px;margin:0 auto;padding:48px 20px 56px;display:flex;flex-wrap:wrap;gap:40px;align-items:center">
    <div style="flex:1 1 340px;min-width:0">
      <h1 style="font-family:Bitter,serif;font-weight:800;font-size:clamp(38px,7vw,64px);line-height:1.02;letter-spacing:-0.02em;margin:20px 0 18px;text-wrap:balance">La placa justa para cada semilla que sembrás.</h1>
      <p style="font-size:clamp(17px,2.2vw,20px);line-height:1.5;margin:0 0 30px;max-width:520px;opacity:0.92;text-wrap:pretty">Fabricamos placas a medida para tu sembradora. Decinos qué máquina tenés y qué vas a sembrar: nosotros te decimos cuál va.</p>
      <div style="display:flex;flex-wrap:wrap;gap:12px">
        <a href={waHref} target="_blank" rel="noopener" style="background:#f6e81d;color:#1d5628;text-decoration:none;padding:16px 24px;border-radius:14px;font-weight:700;font-size:17px;display:flex;align-items:center;gap:10px;min-height:56px">
          <span style="width:10px;height:10px;border-radius:50%;background:#1d5628"></span>Consultar por WhatsApp
        </a>
        <a href="#cotizador" style="border:2px solid rgba(246,242,232,0.5);color:#f6f2e8;text-decoration:none;padding:14px 22px;border-radius:14px;font-weight:600;font-size:17px;display:flex;align-items:center;min-height:56px">Armar mi pedido</a>
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:10px 22px;margin-top:32px;font-size:14px;font-weight:500;opacity:0.9">
        {['Redondas y alargadas', 'Hileras y alvéolos a pedido', 'Te asesoramos antes de comprar'].map(t => (
          <span style="display:flex;align-items:center;gap:8px"><span style="width:8px;height:8px;background:#f6e81d;transform:rotate(45deg)"></span>{t}</span>
        ))}
      </div>
    </div>
    <div style="flex:1 1 360px;min-width:0;position:relative">
      <div class="slot" style="aspect-ratio:1/1;width:100%;border-radius:22px;overflow:hidden;background:#174520">
        <img src="/images/hero-placas.png" alt="Placas de siembra" fetchpriority="high">
      </div>
      <div style="position:absolute;left:-10px;bottom:22px;background:#f6f2e8;color:#1c261e;border-radius:14px;padding:12px 16px;box-shadow:0 10px 30px rgba(0,0,0,0.25);max-width:230px;pointer-events:none">
        <div style="font-size:12px;font-weight:600;color:#541d1d;letter-spacing:0.06em;text-transform:uppercase">Ejemplo de pedido</div>
        <div style="font-family:Bitter,serif;font-weight:700;font-size:17px;margin-top:4px">Redonda · 2 hileras · 60 alvéolos</div>
      </div>
    </div>
  </div>
</section>

<section class="slot" style="height:clamp(220px,34vw,420px);background:#e3dccb">
  <img src="/images/banda-campo.png" alt="Siembra en el campo" loading="lazy">
</section>

<section id="producto" style="max-width:1180px;margin:0 auto;padding:72px 20px 40px">
  <div style="display:flex;flex-wrap:wrap;gap:40px;align-items:flex-start">
    <div style="flex:1 1 320px;min-width:0">
      <div style="font-size:13px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#541d1d">El producto</div>
      <h2 style="font-family:Bitter,serif;font-weight:800;font-size:clamp(30px,5vw,46px);line-height:1.06;letter-spacing:-0.015em;margin:12px 0 18px;color:#1d5628;text-wrap:balance">¿Qué es una placa de siembra?</h2>
      <p style="font-size:18px;line-height:1.6;margin:0;max-width:520px;text-wrap:pretty">Es el disco que va dentro del cajón de la sembradora y toma la semilla de a una. Cada alvéolo —el agujerito del borde— lleva un grano hasta el tubo de bajada. Si la placa es la correcta, la semilla cae pareja y a la distancia que buscás.</p>
    </div>
    <div style="flex:1 1 320px;min-width:0;display:grid;gap:12px">
      {[
        ['Una semilla por alvéolo', 'Evita dobles y fallas en la línea.'],
        ['Densidad pareja en todo el lote', 'La cantidad de alvéolos define cuántas plantas por metro.'],
        ['Hecha para tu semilla', 'Soja, maíz, girasol, sorgo: cada una pide su medida.'],
      ].map(([titulo, texto], i) => (
        <div style="background:#fff;border:1px solid #e3dccb;border-radius:16px;padding:18px 20px;display:flex;gap:16px;align-items:flex-start">
          <span style="flex:none;width:34px;height:34px;border-radius:50%;background:rgba(0,153,25,0.75);color:#fff;display:grid;place-items:center;font-family:Bitter,serif;font-weight:800">{i + 1}</span>
          <div><div style="font-weight:700;font-size:17px">{titulo}</div><div style="font-size:15px;line-height:1.5;color:#4a544b;margin-top:4px">{texto}</div></div>
        </div>
      ))}
    </div>
  </div>

  <h3 style="font-family:Bitter,serif;font-weight:700;font-size:clamp(24px,3.6vw,32px);margin:64px 0 20px;color:#1c261e">Tipos disponibles</h3>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:20px">
    {[
      ['redonda', 'Redonda', 'Alvéolos redondos, ideales para semillas de forma regular como la soja.'],
      ['alargada', 'Alargada', 'Alvéolos alargados para semillas planas o de forma irregular, como maíz o girasol.'],
    ].map(([id, nombre, texto]) => (
      <div style="background:#fff;border:1px solid #e3dccb;border-radius:20px;overflow:hidden">
        <div class="slot" style="aspect-ratio:1/1;background:#ece6d7"><img src={`/images/tipo-${id}.png`} alt={`Placa ${nombre.toLowerCase()}`} loading="lazy"></div>
        <div style="padding:22px 22px 24px">
          <div style="font-family:Bitter,serif;font-weight:800;font-size:24px;color:#1d5628">{nombre}</div>
          <p style="font-size:16px;line-height:1.55;margin:8px 0 0;color:#4a544b">{texto}</p>
        </div>
      </div>
    ))}
  </div>

  <div style="margin-top:20px;background:#541d1d;color:#f6f2e8;border-radius:20px;padding:28px 24px;display:flex;flex-wrap:wrap;gap:28px;align-items:center">
    <div style="flex:1 1 280px;min-width:0">
      <div style="font-family:Bitter,serif;font-weight:800;font-size:24px">Hileras y alvéolos, a pedido</div>
      <p style="font-size:16px;line-height:1.55;margin:10px 0 0;opacity:0.92;text-wrap:pretty">Las <strong>hileras</strong> son las filas de alvéolos alrededor de la placa. Los <strong>alvéolos</strong> son los agujeros donde entra cada semilla. Se combinan según la densidad que buscás.</p>
    </div>
    <div style="flex:1 1 260px;display:flex;gap:12px;flex-wrap:wrap">
      <div style="flex:1 1 110px;background:rgba(246,242,232,0.1);border-radius:14px;padding:16px">
        <div style="font-size:12px;letter-spacing:0.08em;text-transform:uppercase;opacity:0.8">Hileras</div>
        <div style="font-family:Bitter,serif;font-weight:800;font-size:40px;line-height:1.1;color:#f6e81d">2</div>
      </div>
      <div style="flex:1 1 110px;background:rgba(246,242,232,0.1);border-radius:14px;padding:16px">
        <div style="font-size:12px;letter-spacing:0.08em;text-transform:uppercase;opacity:0.8">Alvéolos</div>
        <div style="font-family:Bitter,serif;font-weight:800;font-size:40px;line-height:1.1;color:#f6e81d">60</div>
      </div>
      <div style="flex:1 1 130px;background:rgba(246,242,232,0.1);border-radius:14px;padding:16px">
        <div style="font-size:12px;letter-spacing:0.08em;text-transform:uppercase;opacity:0.8">Medida</div>
        <div style="font-family:Bitter,serif;font-weight:800;font-size:28px;line-height:1.45;color:#f6e81d">12×8×5,5</div>
      </div>
    </div>
  </div>
</section>

<section id="cotizador" style="max-width:1180px;margin:0 auto;padding:56px 20px 72px">
  <div style="font-size:13px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#541d1d">Cómo pedir</div>
  <h2 style="font-family:Bitter,serif;font-weight:800;font-size:clamp(30px,5vw,46px);line-height:1.06;letter-spacing:-0.015em;margin:12px 0 12px;color:#1d5628;text-wrap:balance">Armá tu pedido en un minuto</h2>
  <p style="font-size:18px;line-height:1.55;margin:0 0 32px;max-width:600px;color:#4a544b;text-wrap:pretty">Tocá las opciones y te armamos el mensaje. Si no sabés algún dato, dejalo en blanco: lo vemos juntos por WhatsApp.</p>

  <form id="pedido" data-wa={WA_NUMBER} data-placas={JSON.stringify(placasPorSemilla)} data-libres={JSON.stringify(alveolosLibres)} data-marcas={JSON.stringify(alveolosPorMarca)} data-medidas={JSON.stringify(medidasPorTipo)} style="display:flex;flex-wrap:wrap;gap:24px;align-items:flex-start">
    <div style="flex:1 1 440px;min-width:0;display:grid;gap:14px">

      <fieldset class="card" data-paso="1" disabled>
        <div class="step"><b>1</b>¿Qué sembradora tenés?</div>
        <div style="display:flex;flex-wrap:wrap;gap:10px">
          <select name="maquina" class="field" aria-label="Marca" style="flex:1 1 180px">
            <option value="">Elegí la marca</option>
            {marcas.map(m => <option>{m}</option>)}
          </select>
          <input name="modelo" class="field" placeholder="Modelo (opcional)" aria-label="Modelo" style="flex:1 1 180px">
        </div>
      </fieldset>

      <fieldset class="card" data-paso="2" disabled>
        <div class="step"><b>2</b>¿Qué vas a sembrar?</div>
        <div style="display:flex;flex-wrap:wrap;gap:8px">
          {semillas.map(s => (
            <button type="button" class="chip" data-group="semilla" data-value={s} aria-pressed="false" style="min-height:46px;padding:0 18px;border-radius:999px;font-size:16px;font-weight:600">{s}</button>
          ))}
        </div>
      </fieldset>

      <fieldset class="card" data-paso="3" disabled>
        <div class="step"><b>3</b>¿Redonda o alargada?</div>
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px">
          {formas.map(f => (
            <button type="button" class="chip" data-group="forma" data-value={f.l} aria-pressed="false" style={`min-height:92px;border-radius:14px;border-width:2px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;padding:10px`}>
              <span style={`width:${f.w};height:18px;border-radius:999px;border:2.5px solid currentColor`}></span>
              <span style="font-size:15px;font-weight:700">{f.l}</span>
            </button>
          ))}
        </div>
      </fieldset>

      <fieldset class="card" data-paso="4" disabled>
        <div class="step"><b>4</b>Hileras y alvéolos</div>
        <div id="hileras-libre">
          <div style="font-size:14px;font-weight:600;color:#4a544b;margin-bottom:8px">Hileras</div>
          <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:18px">
            {hileras.map(h => (
              <button type="button" class="chip" data-group="hileras" data-value={h} aria-pressed="false" style="min-width:56px;min-height:48px;padding:0 16px;border-radius:12px;font-size:17px;font-weight:700">{h}</button>
            ))}
          </div>
        </div>
        <div id="hileras-fija" hidden style="font-size:15px;font-weight:600;color:#4a544b;margin-bottom:18px">
          Hileras: <span id="hileras-n" style="font-family:Bitter,serif;font-weight:800;font-size:20px;color:#1d5628"></span>
          <span style="font-weight:400;color:#6a726b"> · fijas para esta semilla</span>
        </div>
        <div style="font-size:14px;font-weight:600;color:#4a544b;margin-bottom:8px">Alvéolos por placa</div>
        <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center">
          <input name="alveolos" class="field" inputmode="numeric" placeholder="Ej. 60" aria-label="Alvéolos por placa" style="width:120px;min-height:48px;font-size:17px;font-weight:700">
          <span id="alv-o" style="font-size:14px;color:#6a726b">o elegí:</span>
          <div id="alv-chips" style="display:flex;flex-wrap:wrap;gap:8px"></div>
        </div>
      </fieldset>

      <fieldset class="card" data-paso="5" disabled>
        <div class="step" style="margin-bottom:6px"><b>5</b>Medida de la placa</div>
        <div style="font-size:14px;color:#6a726b;margin:0 0 12px 40px">Suele estar grabada en la placa que usás hoy.</div>
        <div id="medida-lista" hidden>
          <div style="display:flex;gap:10px;flex-wrap:wrap">
            {['s1', 's2', 's3'].map(n => <select name={n} class="field" style="flex:1 1 130px;font-weight:600"></select>)}
          </div>
        </div>
        <div id="medida-libre">
        <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap">
          {['12', '8', '5,5'].map((ph, i) => (
            <>
              {i > 0 && <span style="font-weight:700;color:#6a726b">×</span>}
              <input name={`m${i + 1}`} class="field" inputmode="decimal" placeholder={ph} aria-label={`Medida ${i + 1}`} style="width:76px;padding:0;text-align:center;font-size:18px;font-weight:700">
            </>
          ))}
        </div>
        </div>
        <label style="margin-top:14px;display:flex;align-items:center;gap:10px;padding:6px 0;cursor:pointer;font-size:16px">
          <input type="checkbox" name="noSe" style="flex:none;width:24px;height:24px;margin:0;accent-color:#1d5628">
          No sé la medida — mando foto de mi placa por WhatsApp
        </label>
      </fieldset>

      <fieldset class="card" data-paso="6" disabled>
        <div class="step"><b>6</b>¿Cuántas placas?</div>
        <div style="display:flex;align-items:center;border:1.5px solid #d6cdb8;border-radius:14px;width:max-content;overflow:hidden;background:#faf8f2">
          <button type="button" data-step="-1" aria-label="Menos" style="width:56px;height:56px;border:none;background:none;font-size:26px;font-weight:600;color:#1d5628;cursor:pointer">−</button>
          <input name="cantidad" value="1" inputmode="numeric" aria-label="Cantidad de placas" style="width:72px;height:56px;border:none;border-left:1.5px solid #d6cdb8;border-right:1.5px solid #d6cdb8;text-align:center;font-size:22px;font-weight:800;background:#fff;color:#1c261e">
          <button type="button" data-step="1" aria-label="Más" style="width:56px;height:56px;border:none;background:none;font-size:26px;font-weight:600;color:#1d5628;cursor:pointer">+</button>
        </div>
        <div style="font-size:14px;color:#6a726b;margin-top:10px">Una por cada cuerpo de siembra de tu máquina.</div>
      </fieldset>

      <fieldset class="card" data-paso="7" disabled>
        <div class="step"><b>7</b><span>Tus datos <span style="font-weight:500;color:#6a726b;font-size:15px">(opcional)</span></span></div>
        <div style="display:flex;flex-wrap:wrap;gap:10px">
          <input name="nombre" class="field" placeholder="Nombre" aria-label="Nombre" style="flex:1 1 180px">
          <input name="localidad" class="field" placeholder="Localidad / provincia" aria-label="Localidad / provincia" style="flex:1 1 180px">
        </div>
      </fieldset>

      <fieldset class="card" data-paso="8" disabled>
        <div class="step"><b>8</b><span>Foto de la placa <span style="font-weight:500;color:#6a726b;font-size:15px">(opcional)</span></span></div>
        <input type="file" name="plano" accept="application/pdf,image/png,image/jpeg,.pdf,.png,.jpg,.jpeg" aria-label="Foto de la placa" style="font-size:15px;max-width:100%">
        <div style="font-size:14px;color:#6a726b;margin-top:10px">PDF, PNG o JPG, hasta 4 MB. El link viaja en el mensaje de WhatsApp.</div>
        <div id="plano-estado" role="status" style="font-size:14px;margin-top:8px;font-weight:600"></div>
      </fieldset>
    </div>

    <aside id="resumen" style="flex:1 1 320px;min-width:0;position:sticky;top:84px;background:#1d5628;color:#f6f2e8;border-radius:22px;padding:24px 22px">
      <div style="font-size:13px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#f6e81d">Vista previa</div>
      <div id="visor" style="margin:14px 0 22px">
        <div style="height:clamp(190px,32vh,320px);width:100%"><canvas id="gl" aria-label="Vista 3D de la placa. Arrastrá para girar, rueda o pellizco para acercar."></canvas></div>
        <div role="group" aria-label="Vistas" style="display:flex;flex-wrap:wrap;gap:6px;justify-content:center;margin-top:10px">
          <button type="button" class="vbtn" data-view="perspectiva" aria-pressed="true">Perspectiva</button>
          <button type="button" class="vbtn" data-view="planta" aria-pressed="false">Planta</button>
          <button type="button" class="vbtn" data-view="canto" aria-pressed="false">Canto</button>
          <button type="button" class="vbtn" data-view="alveolo" aria-pressed="false">Alvéolo</button>
          <button type="button" class="vbtn" id="spinBtn" aria-pressed="false">Girar placa</button>
        </div>
        <div style="font-size:12px;opacity:0.75;text-align:center;margin-top:8px">Arrastrá para girar · rueda o pellizco para zoom · clic derecho para mover</div>
      </div>
      <div style="font-size:13px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#f6e81d">Tu mensaje</div>
      <div id="mensaje" aria-live="polite" style="margin-top:14px;background:#f6f2e8;color:#1c261e;border-radius:16px 16px 16px 4px;padding:16px 18px;font-size:15px;line-height:1.6;white-space:pre-wrap;word-break:break-word"></div>
      <div id="faltan" style="margin-top:14px;font-size:14px;line-height:1.5;background:rgba(0,153,25,0.75);color:#fff;border-radius:12px;padding:10px 14px"></div>
      <a id="enviar" href={waHref} target="_blank" rel="noopener" style="margin-top:18px;display:flex;align-items:center;justify-content:center;gap:10px;background:#f6e81d;color:#1d5628;text-decoration:none;min-height:60px;border-radius:14px;font-weight:800;font-size:18px">
        <span style="width:10px;height:10px;border-radius:50%;background:#1d5628"></span>Enviar pedido por WhatsApp
      </a>
      <button type="reset" style="margin-top:10px;width:100%;background:none;border:none;color:#f6f2e8;opacity:0.8;font-size:14px;text-decoration:underline;cursor:pointer;padding:8px">Empezar de nuevo</button>
    </aside>
  </form>
</section>

<section id="contacto" style="background:#541d1d;color:#f6f2e8">
  <div style="max-width:1180px;margin:0 auto;padding:64px 20px">
    <h2 style="font-family:Bitter,serif;font-weight:800;font-size:clamp(30px,5vw,46px);line-height:1.06;letter-spacing:-0.015em;margin:0 0 10px;text-wrap:balance">Hablemos</h2>
    <p style="font-size:18px;line-height:1.55;margin:0 0 28px;opacity:0.9;max-width:520px">Respondemos por WhatsApp de lunes a sábado. Mandanos foto de tu placa o de tu máquina y te asesoramos.</p>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:14px">
      <a href={waHref} target="_blank" rel="noopener" style="background:#f6e81d;color:#1d5628;text-decoration:none;border-radius:18px;padding:22px;display:flex;flex-direction:column;gap:6px;min-height:130px;justify-content:space-between">
        <span style="font-size:13px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase">WhatsApp · canal principal</span>
        <span style="font-family:Bitter,serif;font-weight:800;font-size:24px">{waDisplay}</span>
      </a>
      <a href="https://facebook.com/" target="_blank" rel="noopener" style="background:rgba(246,242,232,0.08);border:1.5px solid rgba(246,242,232,0.25);color:#f6f2e8;text-decoration:none;border-radius:18px;padding:22px;display:flex;flex-direction:column;gap:6px;min-height:130px;justify-content:space-between">
        <span style="font-size:13px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;opacity:0.85">Facebook</span>
        <span style="font-family:Bitter,serif;font-weight:700;font-size:22px">/placasdesiembra</span>
      </a>
      <a href="mailto:ventas@placasdesiembra.com.ar" style="background:rgba(246,242,232,0.08);border:1.5px solid rgba(246,242,232,0.25);color:#f6f2e8;text-decoration:none;border-radius:18px;padding:22px;display:flex;flex-direction:column;gap:6px;min-height:130px;justify-content:space-between">
        <span style="font-size:13px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;opacity:0.85">Mail</span>
        <span style="font-family:Bitter,serif;font-weight:700;font-size:20px;word-break:break-all">ventas@placasdesiembra.com.ar</span>
      </a>
    </div>
  </div>
</section>
</main>

<footer style="background:#3f1515;color:rgba(246,242,232,0.8);font-size:14px">
  <div style="max-width:1180px;margin:0 auto;padding:22px 20px 96px;display:flex;flex-wrap:wrap;gap:10px 24px;justify-content:space-between">
    <span style="font-family:Bitter,serif;font-weight:700;color:#f6f2e8">Placas de Siembra</span>
    <span>Placas dosificadoras para sembradoras · Argentina</span>
  </div>
</footer>

<a href={waHref} target="_blank" rel="noopener" style="position:fixed;right:16px;bottom:16px;z-index:30;background:#f6e81d;color:#1d5628;text-decoration:none;border-radius:999px;padding:0 20px 0 16px;height:56px;display:flex;align-items:center;gap:10px;font-weight:800;font-size:16px;box-shadow:0 8px 24px rgba(29,86,40,0.35)">
  <span style="width:26px;height:26px;border-radius:50%;background:#1d5628;display:grid;place-items:center"><span style="width:8px;height:8px;border-radius:50%;background:#f6e81d"></span></span>WhatsApp
</a>

<script>
import type { PlacaInput } from '../placa3d';
const form = document.getElementById('pedido') as HTMLFormElement;
const el = (name: string) => form.elements.namedItem(name) as HTMLInputElement;
const pick = (group: string) => (form.querySelector(`[data-group="${group}"][aria-pressed="true"]`) as HTMLElement | null)?.dataset.value || '';

const placas: Record<string, { hileras: string; alveolos: string[] }> = JSON.parse(form.dataset.placas!);
const libres: string[] = JSON.parse(form.dataset.libres!);
const porMarca: Record<string, Record<string, string[]>> = JSON.parse(form.dataset.marcas!);
const medidas: Record<string, string[][]> = JSON.parse(form.dataset.medidas!);
const medidaLibre = document.getElementById('medida-libre')!, medidaLista = document.getElementById('medida-lista')!;
const alvChips = document.getElementById('alv-chips')!, alvO = document.getElementById('alv-o')!;
const hilerasLibre = document.getElementById('hileras-libre')!, hilerasFija = document.getElementById('hileras-fija')!, hilerasN = document.getElementById('hileras-n')!;
let chipsDe: string | null = null; // semilla para la que están dibujados los chips de alvéolos

let planoUrl = '';
const MAX_PLANO = 4 * 1024 * 1024;
const planoEstado = document.getElementById('plano-estado')!;
const setPlano = (url: string, msg: string, ok = true) => {
  planoUrl = url;
  planoEstado.textContent = msg;
  planoEstado.style.color = ok ? '#1d5628' : '#a12b2b';
  update();
};

function update() {
  const v = (n: string) => el(n).value.trim();
  const noSe = el('noSe').checked;
  const [m1, m2, m3] = ['m1', 'm2', 'm3'].map(v);
  ['m1', 'm2', 'm3'].forEach(n => (el(n).disabled = noSe));
  const semilla = pick('semilla');
  // Soja y sorgo no existen alargadas; girasol no existe redonda. Maíz y "Otra" admiten todas.
  const noExiste = semilla === 'Soja' || semilla === 'Sorgo' ? 'Alargada' : semilla === 'Girasol' ? 'Redonda' : '';
  form.querySelectorAll<HTMLButtonElement>('[data-group="forma"]').forEach(b => {
    b.disabled = b.dataset.value === noExiste;
    if (b.disabled) b.setAttribute('aria-pressed', 'false');
  });
  // Hileras y alvéolos: fijos para soja/maíz/girasol/sorgo; libres para "Otra" o sin semilla.
  const cfg = placas[semilla];
  const tiposMaiz = pick('forma') === 'Redonda' ? ['Maíz redondo'] : pick('forma') === 'Alargada' ? ['Maíz alargado'] : ['Maíz alargado', 'Maíz redondo'];
  const deMarca = [...new Set((semilla === 'Maíz' ? tiposMaiz : [semilla]).flatMap(t => porMarca[v('maquina')]?.[t] ?? []))].sort((a, b) => +a - +b);
  const opciones = deMarca.length ? deMarca : cfg?.alveolos ?? libres;
  const clave = opciones.join();
  if (chipsDe !== clave) {
    chipsDe = clave;
    alvChips.replaceChildren(...opciones.map(a => {
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'chip'; b.dataset.alveolos = a; b.setAttribute('aria-pressed', 'false'); b.textContent = a;
      b.style.cssText = 'min-height:44px;padding:0 14px;border-radius:999px;font-size:15px;font-weight:600';
      return b;
    }));
    if (cfg && !opciones.includes(el('alveolos').value)) el('alveolos').value = '';
  }
  el('alveolos').hidden = alvO.hidden = !!cfg;
  hilerasLibre.hidden = !!cfg; hilerasFija.hidden = !cfg;
  if (cfg) hilerasN.textContent = cfg.hileras;
  const forma = pick('forma'), hileras = cfg ? cfg.hileras : pick('hileras'), alveolos = v('alveolos');
  const cantidad = Math.max(1, parseInt(v('cantidad')) || 1);

  // Medida: con semilla (y tipo, en maíz) definidos se elige de una lista en cascada (cada select depende de los anteriores).
  const lista = medidas[semilla === 'Maíz' ? (forma === 'Redonda' ? 'Maíz redondo' : forma === 'Alargada' ? 'Maíz alargado' : '') : semilla];
  medidaLibre.hidden = !!lista; medidaLista.hidden = !lista;
  let partes = [m1, m2, m3];
  if (lista) {
    const n = lista[0].length;
    const nombres = n === 3 ? ['Largo', 'Ancho', 'Espesor'] : ['Diámetro', 'Espesor'];
    const orden = (a: string, b: string) => parseFloat(a.replace(',', '.')) - parseFloat(b.replace(',', '.'));
    let filas = lista;
    partes = [];
    ['s1', 's2', 's3'].forEach((name, k) => {
      const s = el(name);
      s.hidden = k >= n;
      if (k >= n) { s.value = ''; return; }
      const opts = [...new Set(filas.map(r => r[k]))].sort(orden);
      const key = `${nombres[k]}|${opts.join('|')}`;
      if (s.dataset.k !== key) {
        const actual = s.value;
        s.dataset.k = key;
        s.replaceChildren(new Option(`${nombres[k]} (mm)`, ''), ...opts.map(o => new Option(o, o)));
        s.value = opts.includes(actual) ? actual : '';
      }
      if (k > 0 && !partes[k - 1]) s.value = '';
      s.setAttribute('aria-label', nombres[k]);
      s.disabled = noSe || (k > 0 && !partes[k - 1]);
      partes.push(s.value);
      if (s.value) filas = filas.filter(r => r[k] === s.value);
    });
  }
  const medidaOk = noSe || (lista ? partes.every(Boolean) : partes.some(Boolean));
  const medida = noSe ? 'No la sé, te mando foto' : (partes.some(Boolean) ? partes.map(x => x || '?').join('x') : '');
  const maq = [v('maquina'), v('modelo')].filter(Boolean).join(' ');

  const lines = [
    'Hola! Quiero cotizar placas de siembra:',
    `• Máquina: ${maq || '—'}`,
    `• Semilla: ${semilla || '—'}`,
    `• Tipo: ${forma || '—'}`,
    `• Hileras: ${hileras || '—'} · Alvéolos: ${alveolos || '—'}`,
    `• Medida: ${medida || '—'}`,
    `• Cantidad: ${cantidad} placa${cantidad === 1 ? '' : 's'}`,
  ];
  const datos = [v('nombre'), v('localidad')].filter(Boolean).join(' — ');
  if (planoUrl) lines.push(`• Plano: ${planoUrl}`);
  if (datos) lines.push('', datos);
  const mensaje = lines.join('\n');

  const faltan = [!v('maquina') && 'máquina', !semilla && 'semilla', !forma && 'tipo', !hileras && 'hileras', !alveolos && 'alvéolos', !medida && 'medida'].filter(Boolean);
  const faltanEl = document.getElementById('faltan')!;
  faltanEl.hidden = !faltan.length;
  faltanEl.textContent = `Todavía falta: ${faltan.join(', ')}. Podés enviarlo igual y lo completamos por chat.`;

  document.getElementById('mensaje')!.textContent = mensaje;
  (document.getElementById('enviar') as HTMLAnchorElement).href = `https://wa.me/${form.dataset.wa}?text=${encodeURIComponent(mensaje)}`;
  form.querySelectorAll<HTMLElement>('[data-alveolos]').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.alveolos === alveolos)));

  // Cascada: cada paso se habilita recién cuando los anteriores están completos (6, 7 y 8 piden los cinco primeros).
  const ok = [!!v('maquina'), !!semilla, !!forma, !!hileras && !!alveolos, medidaOk];
  form.querySelectorAll<HTMLFieldSetElement>('fieldset[data-paso]').forEach(f => {
    f.disabled = !ok.slice(0, Math.min(Number(f.dataset.paso) - 1, 5)).every(Boolean);
  });

  placaInput = { maquina: v('maquina'), semilla, forma, hileras, alveolos, m: noSe ? ['', '', ''] : partes.length === 2 ? [partes[0], partes[0], partes[1]] : [partes[0], partes[1], partes[2]] }; // redonda: diámetro = largo = ancho
  setPlaca3d?.(placaInput);
}

// El visor 3D (three.js) se carga recién cuando el panel entra en pantalla.
let placaInput: PlacaInput;
let setPlaca3d: ((i: PlacaInput) => void) | undefined;
const visor = document.getElementById('visor')!;
const io = new IntersectionObserver(async ([e]) => {
  if (!e.isIntersecting) return;
  io.disconnect();
  const { initPlaca3d } = await import('../placa3d');
  setPlaca3d = initPlaca3d(visor);
  setPlaca3d(placaInput);
}, { rootMargin: '200px' });
io.observe(visor);

form.addEventListener('click', e => {
  const b = (e.target as HTMLElement).closest('button');
  if (!b) return;
  if (b.dataset.group) {
    const on = b.getAttribute('aria-pressed') !== 'true';
    form.querySelectorAll(`[data-group="${b.dataset.group}"]`).forEach(x => x.setAttribute('aria-pressed', 'false'));
    b.setAttribute('aria-pressed', String(on));
  } else if (b.dataset.alveolos) {
    el('alveolos').value = b.dataset.alveolos;
  } else if (b.dataset.step) {
    el('cantidad').value = String(Math.max(1, (parseInt(el('cantidad').value) || 1) + Number(b.dataset.step)));
  } else return;
  update();
});

form.addEventListener('input', e => {
  const t = e.target as HTMLInputElement;
  if (t.name === 'alveolos' || t.name === 'cantidad') t.value = t.value.replace(/\D/g, '');
  update();
});
el('cantidad').addEventListener('change', () => { el('cantidad').value = String(Math.max(1, parseInt(el('cantidad').value) || 1)); update(); });

el('plano').addEventListener('change', async () => {
  const f = el('plano').files?.[0];
  if (!f) return setPlano('', '');
  if (f.size > MAX_PLANO) { el('plano').value = ''; return setPlano('', 'El archivo supera los 4 MB.', false); }
  if (!/^(application\/pdf|image\/(png|jpeg))$/.test(f.type)) { el('plano').value = ''; return setPlano('', 'Solo PDF, PNG o JPG.', false); }
  setPlano('', 'Subiendo…');
  try {
    const r = await fetch('/api/plano', { method: 'POST', body: f });
    const d = await r.json();
    if (!r.ok) throw new Error(d.error);
    setPlano(d.url, `Plano cargado: ${f.name}`);
  } catch (err) {
    el('plano').value = '';
    setPlano('', (err as Error).message || 'No se pudo subir el archivo.', false);
  }
});

form.addEventListener('reset', () => {
  planoUrl = ''; planoEstado.textContent = '';
  form.querySelectorAll('[data-group]').forEach(x => x.setAttribute('aria-pressed', 'false'));
  setTimeout(update); // reset nativo aplica después del evento
});
form.addEventListener('submit', e => e.preventDefault());

update();
</script>
</body>
</html>
